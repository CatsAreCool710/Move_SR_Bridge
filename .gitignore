# PyInstaller build artifacts
# Anchored: unanchored, these would also swallow a source directory named
# build/ or dist/ at any depth -- e.g. a future scripts/installer/mac/build/
# next to the build.sh that is already there.
/build/
/dist/
*.spec
*.exe

# macOS compiled helper (built by scripts/build_mac.py)
/Move_SR_Bridge/sr_helper_mac

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE / editor / agent state
.vscode/
.idea/
.cursor/
.claude/
*.swp
*.swo
*~

# Merge and patch leftovers
*.orig
*.rej

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Runtime logs (generated by sr_helper at runtime).  The bare *.log catches
# a stray run with HOME pointed at the repo, which the two named patterns
# below would miss.
*.log
Move_SR_Bridge.log
tools/speech_history.log

# GitHub Actions / release build output
Move-SR-Bridge-Windows.zip
Move-SR-Bridge-macOS.zip

# macOS installer app (built by scripts/installer/mac/build.sh)
Install Move-SR-Bridge.app/

# Release script staging directory
/staging/

# Windows reserved name artifact
nul
